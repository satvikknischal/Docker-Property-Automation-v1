# ============================================
# Docker Property Automation - Configuration
# ============================================
# Copy this file to .env and customize for your server
# cp .env.example .env
# ============================================

# ============================================
# Server Configuration
# ============================================
# Your server's base domain (e.g., example.com)
BASE_DOMAIN=subdomain.barium.services

# Timezone (e.g., America/New_York, Europe/London, UTC)
TZ=Asia/Kolkata

# User IDs for file permissions (run: id $USER to get these)
PUID=1000
PGID=1000

# Docker group GID (for containers that need Docker socket access)
# Find with: stat -c '%g' /var/run/docker.sock
DOCKER_GID=999

# Base directory for all container data (relative to project root)
DATA_DIR=./data





# ============================================
# Container Image Versions
# ============================================
# Pin versions for stability, or use 'latest' for auto-updates
# Update these when you want to upgrade services

# Infrastructure
NPM_VERSION=2
PORTAINER_VERSION=lts
CLOUDFLARED_VERSION=1818-66587173e2cd
TAILSCALE_VERSION=stable
NTP_VERSION=latest
#NTP version has to be latest as there are no other versions available for this image

# Media & Entertainment
PLEX_VERSION=1.43.3
FRIGATE_VERSION=0.17.1
IMMICH_VERSION=v3.1.0

# Arr-Stack
PROWLARR_VERSION=2.5.2
RADARR_VERSION=6.3.0
SONARR_VERSION=4.0.19
BAZARR_VERSION=1.5.6
BYPARR_VERSION=latest
SEERR_VERSION=v3.4.1

# Download Clients
QBITTORRENT_VERSION=5.2.3
SABNZBD_VERSION=5.1.2
#5.1.2 fixes an RCE + path-traversal CVE present in 4.x — don't stay behind on this one

# AI & LLM
OPENWEBUI_VERSION=v0.11.1
LITELLM_VERSION=v1.82.3-stable.patch.2
VANE_VERSION=v1.12.2
#Vane is the AI search engine formerly called Perplexica — same author (itzcrazykns),
#renamed in 2026, same self-hosted-Perplexity-alternative product. See Vane/ below.

# Productivity
N8N_VERSION=2.14.2
VAULTWARDEN_VERSION=1.35.4
NEXTCLOUD_AIO_VERSION=latest
#Nextcloud AIO version has to be latest as there are no other versions available for this image
STIRLINGPDF_VERSION=2.9.2

# Home & Utility
HOMEBRIDGE_VERSION=2026-02-01
#Dated tag — not reverified this session, check hub.docker.com/r/homebridge/homebridge/tags before deploying
HOMARR_VERSION=v1.76.2
UPTIME_KUMA_VERSION=2.5.3
TANDOOR_VERSION=2.6.13

# Voice & TTS
WHISPER_VERSION=3.1.0
#Not reverified this session (sources disagreed on the current tag) — check before deploying
PIPER_VERSION=2.4.2

# Search
SEARXNG_VERSION=2026.9.2-fd29de6

# Books
BOOKLORE_VERSION=v2.3.1
SHELFMARK_VERSION=v1.3.0
#Both cross a major/minor version this session — skim release notes before a real deploy

# Sync
OBSIDIAN_SYNC_VERSION=3.5.2
MINECRAFT_VERSION_TAG=java25

# Databases (internal use)
POSTGRES_VERSION=17-alpine
VALKEY_VERSION=9-alpine
MARIADB_VERSION=11.4.13




# ============================================
# Nginx Proxy Manager
# ============================================
# Ports (leave as default unless you have conflicts)
NPM_HTTP_PORT=80
NPM_ADMIN_PORT=81
NPM_HTTPS_PORT=443

# ============================================
# VaultWarden Configuration
# ============================================
# Full domain URL for VaultWarden
VAULTWARDEN_DOMAIN=https://keys.${BASE_DOMAIN}

# Local port binding (127.0.0.1:PORT:80)
VAULTWARDEN_PORT=5100

# Admin token (generate with: openssl rand -base64 48)
# VAULTWARDEN_ADMIN_TOKEN=

# Signup settings
VAULTWARDEN_SIGNUPS_ALLOWED=false
VAULTWARDEN_INVITATIONS_ALLOWED=true

# ============================================
# Common Service Domains (customize as needed)
# ============================================
# Add more service domains here following the pattern:
# SERVICE_NAME_DOMAIN=https://subdomain.${BASE_DOMAIN}

# ============================================
# Optional: Email Configuration (for notifications)
# ============================================
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_FROM=noreply@${BASE_DOMAIN}
SMTP_USERNAME=
SMTP_PASSWORD=




# ============================================
# Optional: Database Configuration
# ============================================
# If you want to use external databases instead of SQLite
# DB_HOST=db.example.com
# DB_PORT=5432
# DB_USER=dbuser
# DB_PASSWORD=dbpassword

# NTP Server Configuration\
# ============================================\
# NTP server port (UDP)\
NTP_PORT=123

# NTP servers (comma-separated, no spaces)\
NTP_SERVERS=in.pool.ntp.org,time.cloudflare.com

# NTP drift file location (optional)\
# NTP_DRIFT_FILE=/data/ntp.drift' .env.example




# ============================================
# Frigate NVR Configuration
# ============================================
# RTSP password for camera authentication
FRIGATE_RTSP_USER=your_rtsp_username_here
FRIGATE_RTSP_PASSWORD=your_rtsp_password_here

# Media storage path (where recordings are saved)
FRIGATE_MEDIA_PATH=/mnt/nas/nvrmedia

# Hardware acceleration device (Intel: /dev/dri/renderD128)
FRIGATE_HW_ACCEL_DEVICE=/dev/dri/renderD128

# Port bindings (RTSP/WebRTC must be exposed for direct camera access)
FRIGATE_RTSP_PORT=8554
FRIGATE_WEBRTC_PORT=8555

# MQTT credentials
FRIGATE_MQTT_USER=your_mqtt_username_here
FRIGATE_MQTT_PASSWORD=your_mqtt_password_here


# ============================================
# Open WebUI Configuration
# ============================================
# Ollama API URL (use host.docker.internal for host-based Ollama)
OPENWEBUI_OLLAMA_URL=http://host.docker.internal:11434

# OpenAI API (optional - leave empty to disable)
OPENWEBUI_OPENAI_BASE_URL=https://api.openai.com/v1
OPENWEBUI_OPENAI_API_KEY=

# Secret key for session encryption (generate with: openssl rand -hex 32)
OPENWEBUI_SECRET_KEY=

# Enable authentication (true/false)
OPENWEBUI_AUTH=true




# ============================================
# Plex Media Server Configuration
# ============================================
# Media library path
PLEX_MEDIA_PATH=/path/to/your/media

# Plex claim token (get from https://plex.tv/claim - optional, for initial setup)
PLEX_CLAIM_TOKEN=

# Web UI port (default 32400)
PLEX_PORT=32400

# GPU device for hardware transcoding (Intel: /dev/dri, Nvidia: see nvidia-docker)
PLEX_GPU_DEVICE=/dev/dri




# ============================================
# Stirling PDF Configuration
# ============================================
# Admin credentials (required for login)
STIRLING_ADMIN_USERNAME=your_email@example.com
STIRLING_ADMIN_PASSWORD=your_secure_password

# Security settings
STIRLING_ENABLE_SECURITY=true
STIRLING_ENABLE_LOGIN=true
STIRLING_CSRF_DISABLED=false

# Localization
STIRLING_LOCALE=en-US
STIRLING_LANGS=en_US

# Enable advanced book/HTML operations (requires additional dependencies)
STIRLING_ADVANCED_OPS=false




# ============================================
# SABnzbd Configuration
# ============================================
# Download paths
SABNZBD_DOWNLOADS_PATH=/path/to/downloads
SABNZBD_INCOMPLETE_PATH=/path/to/incomplete-downloads




# ============================================
# Homarr Dashboard Configuration
# ============================================
# Encryption key for secrets (generate with: openssl rand -hex 32)
HOMARR_SECRET_KEY=your_generated_key_here




# ============================================
# Nextcloud AIO Configuration
# ============================================
NEXTCLOUD_DOMAIN=cloud.yourdomain.com
NEXTCLOUD_SKIP_DOMAIN_VALIDATION=true
NEXTCLOUD_AIO_PORT=8080
NEXTCLOUD_COLLABORA_ENABLED=no
NEXTCLOUD_TALK_ENABLED=no
NEXTCLOUD_IMAGINARY_ENABLED=no
NEXTCLOUD_FULLTEXTSEARCH_ENABLED=no




# ============================================
# Faster Whisper (Speech-to-Text) Configuration
# ============================================
# Wyoming protocol port (for Home Assistant integration)
WHISPER_PORT=10300

# Whisper model size (tiny, base, small, medium, large-v2, large-v3)
# Larger = more accurate but slower and more memory
WHISPER_MODEL=base

# Language code (en, es, fr, de, etc. or 'auto' for auto-detect)
WHISPER_LANG=en

# Beam size (0 = greedy decoding, higher = more accurate but slower)
WHISPER_BEAM=0




# ============================================
# Piper TTS (Text-to-Speech) Configuration
# ============================================
# Wyoming protocol port (for Home Assistant integration)
PIPER_PORT=10200

# Voice model (e.g., en_US-lessac-medium, en_GB-alba-medium)
# See: https://rhasspy.github.io/piper-samples/
PIPER_VOICE=en_US-lessac-medium

# Speech length scale (1.0 = normal speed, <1 = faster, >1 = slower)
PIPER_LENGTH=1.0

# Phoneme noise (adds variability, 0-1)
PIPER_NOISE=0.667

# Phoneme width noise (0-1)
PIPER_NOISEW=0.333

# Speaker ID for multi-speaker models (default 0)
PIPER_SPEAKER=0

# Number of Piper processes (default 1)
PIPER_PROCS=1




# ============================================
# SearXNG Configuration
# ============================================
# Base URL (must match your NPM proxy host)
SEARXNG_BASE_URL=https://search.yourdomain.com/

# Secret key (generate with: openssl rand -hex 32)
SEARXNG_SECRET=your_generated_secret_here




# ============================================
# Vane Configuration
# ============================================
# AI search engine — formerly Perplexica, renamed by the same author in 2026.
# SearXNG API URL (use container name on same network)
VANE_SEARXNG_URL=http://searxng:8080

# Ollama URL (for local LLM)
VANE_OLLAMA_URL=http://host.docker.internal:11434

# OpenAI API Key (optional, leave empty if using Ollama)
VANE_OPENAI_API_KEY=




# ============================================
# qBittorrent Configuration
# ============================================
# Downloads path
QB_DOWNLOADS_PATH=/path/to/downloads

# Torrenting port (must be exposed for peer connections)
QB_TORRENTING_PORT=6881




# ============================================
# n8n Workflow Automation
# ============================================
# Subdomain for n8n (will be: n8n.your-domain.com)
N8N_SUBDOMAIN=n8n

# Optional: Enable basic authentication
N8N_BASIC_AUTH_ACTIVE=false
N8N_BASIC_AUTH_USER=
N8N_BASIC_AUTH_PASSWORD=

# Encryption key for credentials storage (generate with: openssl rand -hex 32)
# IMPORTANT: Back this up! If lost, you cannot decrypt stored credentials
# N8N_ENCRYPTION_KEY=



# ============================================
# LiteLLM API Proxy
# ============================================
# Subdomain for litellm (will be: litellm.your-domain.com)
# Required - Generate these!
LITELLM_MASTER_KEY=        # openssl rand -hex 32
LITELLM_SALT_KEY=          # openssl rand -hex 32

#Required for WebUI
LITELLM_UI_PASSWORD=your_password_here
LITELLM_UI_USERNAME=your_username_here

# LLM Provider Keys (add what you use)
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...
GOOGLE_API_KEY=...

# Local Ollama
OLLAMA_API_BASE=http://host.docker.internal:11434

LITELLM_DB_NAME=litellm
LITELLM_DB_USER=litellm
LITELLM_DB_PASSWORD=       # PostgreSQL password




# ============================================
# Mine Craft Game Server
# ============================================
# Server type & version
MC_TYPE=PAPER              
# VANILLA, PAPER, SPIGOT, FORGE, FABRIC
MC_VERSION=LATEST
MC_MEMORY=2G

# Game settings
MC_DIFFICULTY=normal       
# peaceful, easy, normal, hard
MC_GAMEMODE=survival       
# survival, creative, adventure, spectator
MC_MOTD=A Minecraft Server
MC_MAX_PLAYERS=20

# Security
MC_ONLINE_MODE=true        
# Verify player accounts with Mojang
MC_RCON_PASSWORD=changeme  
# ⚠️ CHANGE THIS!

# Whitelist (comma-separated)
MC_OPS=player1,player2
MC_WHITELIST=




# ============================================
# Immich - Photo & Video Management
# ============================================

# Storage locations
# Upload location - can be network share mounted on host
IMMICH_UPLOAD_LOCATION=/path/to/your/photos

# Database location - MUST be local storage, NOT network share!
IMMICH_DB_LOCATION=./Immich/postgres-data

# Database credentials (generate password with: openssl rand -base64 32)
IMMICH_DB_USERNAME=immich
IMMICH_DB_PASSWORD=
IMMICH_DB_NAME=immich




# ============================================
# Shelfmark - Book Download Manager
# ============================================
# Path to your book library (can be network share)
SHELFMARK_BOOKS_PATH=/path/to/books

# Download client path (must match your torrent/usenet client volume)
SHELFMARK_DOWNLOADS_PATH=/path/to/downloads




# ============================================
# BookLore - Book Library Manager
# ============================================
# Path to your book library (can be network share)
BOOKLORE_BOOKS_PATH=/path/to/books

# Database credentials (generate passwords with: openssl rand -base64 24)
BOOKLORE_DB_NAME=booklore
BOOKLORE_DB_USER=booklore
BOOKLORE_DB_PASSWORD=
BOOKLORE_DB_ROOT_PASSWORD=

# Application settings
BOOKLORE_SWAGGER_ENABLED=false
BOOKLORE_FORCE_DISABLE_OIDC=false




# ============================================
# Tandoor Recipes - Recipe Manager
# ============================================
# Secret key for Django (generate with: openssl rand -hex 32)
TANDOOR_SECRET_KEY=

# Database credentials (generate password with: openssl rand -base64 24)
TANDOOR_DB_NAME=tandoor
TANDOOR_DB_USER=tandoor
TANDOOR_DB_PASSWORD=

# Application settings
# Set to 0 after creating your account to disable public registration
TANDOOR_ENABLE_SIGNUP=1




# ============================================
# Arr-Stack (Radarr, Sonarr, etc.)
# ============================================
# Media library paths (can be network shares)
# Shared by Radarr/Sonarr and by Bazarr (subtitles) — keep these consistent
ARR_MOVIES_PATH=/path/to/movies
ARR_TV_PATH=/path/to/tv

# Download client path (must match your torrent/usenet client volume)
ARR_DOWNLOADS_PATH=/path/to/downloads




# ============================================
# Obsidian LiveSync
# ============================================
# CouchDB credentials for Obsidian sync
# Use a strong password - this protects your notes! DO NOT USE SPECIAL CHARACTERS OR SPACES IN THE PASSWORD!!
OBSIDIAN_SYNC_USER=obsidian
OBSIDIAN_SYNC_PASSWORD=




# ============================================
# Tailscale - Secure Mesh VPN & Remote Access
# ============================================
# Auth key — generate at https://login.tailscale.com/admin/settings/keys
#   • Check "Reusable" so the container can re-auth on restart
#   • Optionally check "Ephemeral" for auto-cleanup of stale nodes
#   • Or use an OAuth client secret with ACL tags for production
TS_AUTHKEY=tskey-auth-xxxxxxxxxxxxx

# Hostname for this node in your tailnet (shown in Tailscale admin console)
TS_HOSTNAME=barium-ubuntu-server

# Subnet routes to advertise (comma-separated CIDRs, NO spaces)
# Include your LAN subnet AND the Docker bridge subnet so remote
# devices can reach all services without per-container Tailscale.
#   • Find your LAN: ip route | grep 'src' | head -1
#   • Find Docker bridge: docker network inspect proxy-network --format '{{range .IPAM.Config}}{{.Subnet}}{{end}}'
# Example: 192.168.1.0/24,172.18.0.0/16
# NOTE: TS_ROUTES/TS_ACCEPT_DNS are read NATIVELY by the container entrypoint
# (containerboot) via env_file — Tailscale/docker-compose.yml must NOT also
# bake --advertise-routes/--accept-dns into TS_EXTRA_ARGS, or the duplicate
# flag makes `tailscale up` exit 2 and the container crash-loops.
TS_ROUTES=192.168.1.0/24,172.18.0.0/16

# Accept MagicDNS from tailnet (true/false)
TS_ACCEPT_DNS=true


# ============================================
# Cloudflared Configuration
# ============================================
# Cloudflared tunnel token. Generate a new token at https://dash.cloudflare.com/
CLOUDFLARED_TUNNEL_TOKEN=